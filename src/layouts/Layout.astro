---
import "../styles/global.css";
import PostHog from "../components/posthog.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonical?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = "Terminal for agentic workflows. Attyx tracks agent state in the tab bar and drives panes over an IPC layer and the attyx CLI. Sessions, splits, tabs, command palette — all built in. Written in Zig, under 5MB.",
  image,
  type = "website",
  canonical,
  jsonLd,
} = Astro.props;

const siteUrl = "https://attyx.sh";
const ogImage = image?.startsWith("http") ? image : `${siteUrl}${image || "/images/attyx-og.png"}`;
const pageUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/logos/Attyx.png" />
    <link rel="apple-touch-icon" href="/logos/Attyx.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Attyx" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      />
    </noscript>
    <PostHog />
    <title>{title}</title>
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Nav -->
    <nav class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] w-[min(90vw,1100px)] px-4 md:px-8 py-3 md:py-4 bg-black/85 backdrop-blur-md border border-gray-800 rounded-lg shadow-[0_4px_20px_-4px_rgba(0,0,0,0.5)]">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 min-w-0">
          <img src="/logos/Attyx.png" alt="Attyx" class="w-7 h-7 md:w-8 md:h-8 rounded-sm shrink-0" />
          <span class="font-hand text-title tracking-[0.01em] hover:text-white transition-colors focus:outline-none focus:text-white focus:ring-1 focus:ring-white/30 rounded-sm px-1">Attyx</span>
        </a>
        <div class="flex items-center gap-4 md:gap-8 text-label md:text-body-sm text-gray-300 shrink-0">
          <a href="/docs/" class="hover:text-white transition-colors focus:outline-none focus:text-white focus:ring-1 focus:ring-white/30 rounded-sm px-1" data-ph-cta="nav_docs">Docs</a>
          <a href="https://semos.sh/blog" target="_blank" rel="noopener" class="hover:text-white transition-colors focus:outline-none focus:text-white focus:ring-1 focus:ring-white/30 rounded-sm px-1" data-ph-cta="nav_blog">Blog</a>
          <a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="hover:text-white transition-colors focus:outline-none focus:text-white focus:ring-1 focus:ring-white/30 rounded-sm px-1" data-ph-cta="nav_github">
            GitHub
          </a>
        </div>
      </div>
    </nav>

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="py-16 px-6 md:px-8 border-t border-gray-800 bg-black">
      <div class="max-w-content mx-auto grid grid-cols-2 md:grid-cols-12 gap-8 md:gap-10">
        <!-- Brand -->
        <div class="col-span-2 md:col-span-4 flex flex-col gap-4 md:pr-8">
          <a href="/" class="flex items-center gap-3">
            <img src="/logos/Attyx.png" alt="Attyx" class="w-8 h-8 rounded-sm shrink-0" />
            <span class="font-hand text-title-lg">Attyx</span>
          </a>
          <p class="text-body-sm text-gray-400 leading-relaxed max-w-[280px]">
            The GPU-accelerated terminal built for the agentic era — agent-aware end to end, scriptable over IPC, CLI, and MCP. Written in Zig, under 5&thinsp;MB.
          </p>
          <div class="flex flex-wrap gap-x-3 gap-y-1.5 text-[0.7rem] text-gray-600 font-mono tracking-wider uppercase">
            <span>macOS</span><span class="text-gray-800">·</span><span>Linux</span><span class="text-gray-800">·</span><span>MIT</span>
          </div>
        </div>

        <!-- Documentation -->
        <div class="md:col-span-3 flex flex-col gap-3">
          <span class="text-label text-gray-300 tracking-[0.2em] uppercase">Docs</span>
          <ul class="space-y-2 text-body-sm text-gray-400 font-mono">
            <li><a href="/docs/" class="hover:text-white transition-colors" data-ph-cta="footer_docs">Getting started</a></li>
            <li><a href="/docs/agent-workflows/" class="hover:text-white transition-colors" data-ph-cta="footer_agent_workflows">Agent workflows</a></li>
            <li><a href="/docs/integration/" class="hover:text-white transition-colors" data-ph-cta="footer_integration">IPC &amp; CLI</a></li>
            <li><a href="/docs/mcp/" class="hover:text-white transition-colors" data-ph-cta="footer_mcp">MCP server</a></li>
            <li><a href="/docs/command-palette/" class="hover:text-white transition-colors" data-ph-cta="footer_palette">Command palette</a></li>
            <li><a href="/docs/themes/" class="hover:text-white transition-colors" data-ph-cta="footer_themes">Themes</a></li>
          </ul>
        </div>

        <!-- Project -->
        <div class="md:col-span-2 flex flex-col gap-3">
          <span class="text-label text-gray-300 tracking-[0.2em] uppercase">Project</span>
          <ul class="space-y-2 text-body-sm text-gray-400 font-mono">
            <li><a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_github">GitHub</a></li>
            <li><a href="https://github.com/semos-labs/attyx/releases" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_releases">Releases</a></li>
            <li><a href="https://github.com/semos-labs/attyx/issues" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_issues">Issues</a></li>
            <li><a href="/docs/architecture/" class="hover:text-white transition-colors" data-ph-cta="footer_architecture">Architecture</a></li>
            <li><a href="/docs/building/" class="hover:text-white transition-colors" data-ph-cta="footer_building">Build from source</a></li>
          </ul>
        </div>

        <!-- Semos constellation -->
        <div class="md:col-span-3 flex flex-col gap-3">
          <span class="text-label text-gray-300 tracking-[0.2em] uppercase">Semos Labs</span>
          <ul class="space-y-2 text-body-sm text-gray-400 font-mono">
            <li><a href="https://semos.sh" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_semos">semos.sh</a></li>
            <li><a href="https://semos.sh/glyph" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_glyph">Glyph</a></li>
            <li><a href="https://semos.sh/aion" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_aion">Aion</a></li>
            <li><a href="https://semos.sh/epist" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_epist">Epist</a></li>
            <li><a href="https://semos.sh/blog" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-ph-cta="footer_blog">Blog</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-content mx-auto mt-12 pt-8 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-small text-gray-500">
        <p>&copy; <span id="footer-year"></span> Semos Labs. Attyx is MIT licensed.</p>
        <p class="font-mono text-[0.72rem] text-gray-600">A constellation of terminal-native tools.</p>
      </div>
    </footer>
    <script>
      document.getElementById('footer-year').textContent = new Date().getFullYear();
      document.querySelectorAll('[data-ph-cta]').forEach(function(el) {
        el.addEventListener('click', function() {
          if (window.posthog) {
            window.posthog.capture('cta_click', {
              cta: el.getAttribute('data-ph-cta'),
              url: el.getAttribute('href'),
              page: window.location.pathname,
            });
          }
        });
      });
    </script>
  </body>
</html>
