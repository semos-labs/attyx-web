---
import Layout from "../layouts/Layout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Attyx",
  description: "Terminal for agentic workflows. Attyx tracks agent lifecycle, drives panes over an IPC layer and the attyx CLI, and ships sessions, splits, tabs, and a command palette. GPU-accelerated, written in Zig, under 5MB.",
  url: "https://attyx.sh",
  operatingSystem: ["macOS", "Linux"],
  applicationCategory: "DeveloperApplication",
  screenshot: "https://attyx.sh/images/attyx.webp",
  author: {
    "@type": "Organization",
    name: "Semos Labs",
    url: "https://semos.sh",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// Sidebar tabs for the terminal chrome — label + per-tab agent-status dot.
const features = [
  { id: "agents",  tab: "agents",  dot: "working" },
  { id: "cli",     tab: "cli",     dot: "working" },
  { id: "splits",  tab: "splits",  dot: "idle" },
  { id: "palette", tab: "palette", dot: "idle" },
  { id: "themes",  tab: "themes",  dot: "idle" },
];
---

<Layout title="Attyx — Terminal for Agentic Workflows" description="Terminal for agentic workflows. Attyx tracks agent state in the tab bar and drives panes over an IPC layer and the attyx CLI. GPU-accelerated, written in Zig, under 5MB." jsonLd={jsonLd}>

  <!-- Boot sequence overlay -->
  <div id="boot-overlay" class="fixed inset-0 z-[200] bg-black flex items-center justify-center pointer-events-none">
    <svg id="boot-logo" width="80" height="80" viewBox="0 0 100 100" fill="none" class="opacity-0">
      <circle cx="50" cy="50" r="38" stroke="#404040" stroke-width="3" stroke-dasharray="239" stroke-dashoffset="239" class="boot-circle" />
      <line x1="22" y1="22" x2="78" y2="78" stroke="#f0f0f0" stroke-width="3" stroke-linecap="round" stroke-dasharray="80" stroke-dashoffset="80" class="boot-x1" />
      <line x1="78" y1="22" x2="22" y2="78" stroke="#f0f0f0" stroke-width="3" stroke-linecap="round" stroke-dasharray="80" stroke-dashoffset="80" class="boot-x2" />
    </svg>
  </div>

  <!-- Hero -->
  <section class="min-h-dvh flex flex-col justify-center pt-24 md:pt-32 pb-12 md:pb-20 px-6 md:px-8 relative overflow-hidden">
    <!-- Ambient grid -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#f0f0f0 1px, transparent 1px), linear-gradient(90deg, #f0f0f0 1px, transparent 1px); background-size: 60px 60px;"></div>
    <!-- Corner coordinates -->
    <div class="absolute top-20 left-6 md:left-8 text-[0.65rem] text-gray-600 font-mono tracking-wider hero-stagger" style="--delay: 0.8s">0,0</div>
    <div class="absolute top-20 right-6 md:right-8 text-[0.65rem] text-gray-600 font-mono tracking-wider hero-stagger" style="--delay: 0.85s">1920,0</div>

    <div class="max-w-content mx-auto w-full relative">
      <!-- Main heading -->
      <h1 class="hero-stagger" style="--delay: 0.5s">
        <span class="block text-[2rem] md:text-[3.6rem] lg:text-[4.2rem] leading-[1.1] tracking-[-0.03em] font-bold text-balance">
          <span class="text-gray-400">Terminal for</span><br />
          agentic workflows.
        </span>
      </h1>

      <!-- Description -->
      <p class="hero-stagger mt-6 md:mt-8 text-body-lg md:text-[1.05rem] text-gray-300 leading-copy" style="--delay: 0.6s">
        Attyx is the terminal for the agentic era — built to run, watch, and coordinate AI agents without leaving your shell. Agent-aware end to end, scriptable over IPC, the <code class="text-gray-100">attyx</code> CLI, and MCP. GPU-accelerated, written in Zig, under 5&thinsp;MB.
      </p>

      <!-- Badges -->
      <div class="hero-stagger mt-5 flex items-center gap-3 flex-wrap" style="--delay: 0.65s">
        <a
          class="version-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx/releases/latest"
          target="_blank"
          rel="noopener"
        >
          <span class="w-1.5 h-1.5 rounded-full" style="background:#28c840"></span>
          <span class="version-tag font-mono font-medium">—</span>
        </a>
        <a
          class="stars-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-3 h-3 fill-amber-400" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
          <span class="stars-count font-mono font-medium">—</span>
        </a>
        <a
          class="downloads-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx/releases"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-3 h-3 fill-gray-400" viewBox="0 0 16 16"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14ZM7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>
          <span class="dl-count font-mono font-medium">—</span>
        </a>
      </div>

      <!-- Get it — install (half) + a vertical action list to the right -->
      <div class="hero-stagger mt-8 md:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-5 lg:gap-6 items-stretch" style="--delay: 0.7s">
        <!-- Install -->
        <div class="install-block flex flex-col bg-gray-900/80 border border-gray-700/60 rounded-xl overflow-hidden backdrop-blur-sm">
          <div class="flex items-center px-4 py-2.5 bg-gray-800/60 border-b border-gray-700/40 gap-3">
            <div class="flex gap-1.5">
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
            </div>
            <span class="text-[0.65rem] text-gray-500 tracking-wider uppercase">Install</span>
            <button
              class="copy-btn group ml-auto flex items-center bg-transparent border border-gray-700/60 rounded px-2 py-0.5 cursor-pointer text-gray-500 text-[0.7rem] transition-all hover:text-white hover:border-gray-500"
              data-ph-cta="hero_copy_install"
              aria-label="Copy to clipboard"
            >
              <span class="group-[.copied]:hidden">copy</span>
              <span class="hidden group-[.copied]:inline text-gray-200">copied</span>
            </button>
          </div>
          <div class="install-panel flex-1 px-5 py-4 text-[0.82rem] leading-loose" data-copy="brew tap semos-labs/tap&#10;brew install attyx">
            <p><span class="text-gray-500">$</span> <span class="text-white">brew tap semos-labs/tap</span></p>
            <p><span class="text-gray-500">$</span> <span class="text-white">brew install attyx</span></p>
            <p><span class="text-gray-500">$</span> <span class="text-white">attyx</span> <span class="text-gray-600"># launch it</span></p>
          </div>
        </div>

        <!-- Actions — vertical list -->
        <div class="flex flex-col gap-3">
          <!-- Download (platform-detected, hidden by default) -->
          <div id="hero-download-wrap" class="hidden flex flex-col gap-1.5">
            <a id="hero-download-btn" href="#" class="flex items-center justify-center gap-2 py-3 px-5 bg-white text-black font-mono text-body-sm font-medium rounded-md hover:bg-gray-200 transition-colors" data-ph-cta="hero_download">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download
            </a>
            <span id="hero-download-caption" class="text-[0.68rem] text-gray-500 text-center"></span>
          </div>
          <a href="/docs/" class="group flex items-center justify-center gap-2 py-3 px-5 border border-gray-500 rounded-md font-mono text-body-sm text-white tracking-wide transition-all hover:bg-white hover:text-black hover:border-white" data-ph-cta="hero_docs">
            Documentation
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 py-3 px-5 border border-gray-700 rounded-md font-mono text-body-sm text-gray-300 tracking-wide transition-all hover:text-white hover:border-gray-500" data-ph-cta="hero_github">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.76-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            GitHub
          </a>
          <span class="mt-auto pt-1 text-[0.7rem] text-gray-500 text-center">macOS (Apple Silicon &amp; Intel) &middot; Linux (x64 &amp; ARM64)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Specs strip -->
  <section class="py-10 px-6 md:px-8 border-y border-gray-800/60">
    <div class="max-w-content mx-auto flex flex-wrap justify-center gap-x-4 md:gap-x-5 gap-y-2.5 text-[0.75rem] text-gray-500 font-mono tracking-wider uppercase">
      <span>Zig</span>
      <span class="text-gray-700">/</span>
      <span>Metal &middot; OpenGL</span>
      <span class="text-gray-700">/</span>
      <span>&lt; 5 MB</span>
      <span class="text-gray-700">/</span>
      <span>IPC &middot; CLI &middot; MCP</span>
      <span class="text-gray-700">/</span>
      <span>macOS &middot; Linux</span>
      <span class="text-gray-700">/</span>
      <span>MIT License</span>
    </div>
  </section>

  <!-- Feature showcase: one terminal that adapts to whatever you're reading -->
  <section id="showcase" class="relative border-t border-gray-800/60">
    <div class="showcase-track relative min-h-[420vh] px-6 md:px-8">

      <!-- Sticky stage: copy + terminal share one vertically-centered row, so they
           stay aligned; both cross-fade in lock-step as the active feature changes. -->
      <div class="showcase-stage sticky top-0 h-[100svh] flex items-center overflow-hidden">
        <div class="max-w-content mx-auto w-full">

          <!-- Header — kicker, heading, description, link stacked; cross-fades per
               feature. Active screen is in-flow so the box sizes to its content. -->
          <div class="relative mb-8 lg:mb-12">
            <div class="copy-screen is-active" data-copy="0">
              <div class="flex items-center gap-4 mb-5">
                <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Agent status</span>
                <div class="flex-1 h-px bg-gray-800"></div>
              </div>
              <h3 class="heading-section text-balance mb-4">See every agent at a glance.</h3>
              <p class="text-body-lg md:text-[1rem] text-gray-300 leading-copy">
                Attyx reads each agent's lifecycle — Claude, Codex, opencode, pi.dev — and paints a colored dot on its pane: <span class="text-white">working</span>, <span class="text-white">waiting on you</span>, or <span class="text-white">idle</span>. Run a swarm and see which one needs you.
              </p>
              <a href="/docs/agent-workflows/" class="group inline-flex items-center gap-2 mt-5 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_agent_status">
                <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">Agent workflows</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>

            <div class="copy-screen" data-copy="1">
              <div class="flex items-center gap-4 mb-5">
                <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">CLI control</span>
                <div class="flex-1 h-px bg-gray-800"></div>
              </div>
              <h3 class="heading-section text-balance mb-4">Drive it from anywhere.</h3>
              <p class="text-body-lg md:text-[1rem] text-gray-300 leading-copy">
                Every pane has a stable ID. Over a Unix socket, one agent spawns panes, sends keystrokes, and reads output from any other. It speaks <span class="text-gray-100">MCP</span> too — <code class="text-gray-100">attyx mcp</code> hands the same tools to Claude and any MCP client.
              </p>
              <a href="/docs/integration/" class="group inline-flex items-center gap-2 mt-5 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_cli">
                <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">IPC &amp; CLI</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>

            <div class="copy-screen" data-copy="2">
              <div class="flex items-center gap-4 mb-5">
                <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Splits &amp; sessions</span>
                <div class="flex-1 h-px bg-gray-800"></div>
              </div>
              <h3 class="heading-section text-balance mb-4">Lay it out. Leave it running.</h3>
              <p class="text-body-lg md:text-[1rem] text-gray-300 leading-copy">
                Vertical and horizontal splits, tabs, and floating popups — all built in, no plugin needed. Sessions are daemon-backed: close the window, reopen tomorrow, every pane exactly where you left it.
              </p>
              <a href="/docs/tabs-and-splits/" class="group inline-flex items-center gap-2 mt-5 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_splits">
                <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">Tabs &amp; splits</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>

            <div class="copy-screen" data-copy="3">
              <div class="flex items-center gap-4 mb-5">
                <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Command palette</span>
                <div class="flex-1 h-px bg-gray-800"></div>
              </div>
              <h3 class="heading-section text-balance mb-4">Every command, a keystroke away.</h3>
              <p class="text-body-lg md:text-[1rem] text-gray-300 leading-copy">
                <kbd class="inline-flex items-center px-1.5 py-0.5 rounded border border-gray-600/50 bg-gray-900/60 text-[0.72rem] text-gray-200 align-middle">⌘⇧P</kbd> opens a fuzzy-searchable list of every action — split, theme, session, search. Forgot a shortcut? Type a few letters and run it.
              </p>
              <a href="/docs/command-palette/" class="group inline-flex items-center gap-2 mt-5 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_palette">
                <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">Command palette</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>

            <div class="copy-screen" data-copy="4">
              <div class="flex items-center gap-4 mb-5">
                <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Themes</span>
                <div class="flex-1 h-px bg-gray-800"></div>
              </div>
              <h3 class="heading-section text-balance mb-4">Twenty-two themes, ready to wear.</h3>
              <p class="text-body-lg md:text-[1rem] text-gray-300 leading-copy">
                Catppuccin, Dracula, Gruvbox, Nord, Tokyo Night and more — preview them live in the palette, or drop a TOML file in your config to ship your own.
              </p>
              <a href="/docs/themes/" class="group inline-flex items-center gap-2 mt-5 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_themes">
                <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">Themes</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>
          </div>

          <!-- Terminal — wide & tall; chrome mirrors the real Attyx window:
               left tab sidebar + top status line, no traffic lights, no footer. -->
          <div class="showcase-term flex bg-gray-900 border border-gray-700/50 rounded-xl overflow-hidden shadow-[0_28px_80px_-30px_rgba(0,0,0,0.9)] font-mono">

            <!-- Left tab sidebar — the feature nav, with per-tab agent-status dots -->
            <div class="term-tabs w-[108px] sm:w-[168px] lg:w-[208px] shrink-0 border-r border-gray-800 py-2" role="tablist" aria-label="Features">
              {features.map((f, i) => (
                <button
                  type="button"
                  class:list={["term-tab flex items-center gap-2 mx-1.5 px-2.5 py-1.5 rounded-md text-[0.72rem] text-left w-[calc(100%-0.75rem)] transition-colors", i === 0 && "is-active"]}
                  data-tab={i}
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-ph-cta={`showcase_tab_${f.id}`}
                >
                  <span class="status-dot shrink-0" data-state={f.dot}></span>
                  <span class="term-tab-spark shrink-0 text-[0.7rem] leading-none" style="color:#fbbf24" aria-hidden="true">✳</span>
                  <span class="flex-1 truncate">{f.tab}</span>
                  <span class="term-tab-num shrink-0 text-[0.62rem] text-gray-600 tabular-nums">{i + 1}</span>
                </button>
              ))}
            </div>

            <!-- Right column: top status bar + content -->
            <div class="flex-1 min-w-0 flex flex-col">

              <!-- Top status bar — cwd · branch · diff stats · clock -->
              <div class="flex items-center gap-2.5 sm:gap-3 px-4 py-2 border-b border-gray-800 text-[0.7rem]">
                <span class="term-path text-gray-200 truncate">~/agents</span>
                <span class="flex items-center gap-1 shrink-0 text-gray-500">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.508 2.508 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Z"/></svg>
                  main
                </span>
                <span class="hidden sm:flex items-center gap-2.5 shrink-0 tabular-nums">
                  <span style="color:#28c840">+405</span>
                  <span style="color:#ff5f57">−298</span>
                </span>
                <span class="ml-auto shrink-0 text-gray-600 tabular-nums">5:51 PM</span>
              </div>

              <!-- Content — feature screens cross-fade here -->
              <div class="showcase-body relative h-[280px] sm:h-[340px] lg:h-[clamp(340px,42vh,420px)] overflow-hidden text-[0.75rem]">

                <!-- 0 · Agent status -->
                <div class="screen is-active" data-screen="0" data-path="~/agents" role="tabpanel" aria-label="Agent status">
                  <div class="px-4 sm:px-5 py-4 h-full flex flex-col leading-relaxed text-[0.78rem]">
                    <p class="text-gray-500 mb-4"><span class="text-gray-600">$</span> attyx watch</p>
                    <div class="space-y-2.5">
                      <div class="flex items-center gap-3">
                        <span class="status-dot shrink-0" data-state="working"></span>
                        <span class="w-16 sm:w-20 shrink-0 text-gray-100">test</span>
                        <span class="hidden sm:inline w-20 shrink-0" style="color:#ffaa40">working</span>
                        <span class="flex-1 min-w-0 truncate text-gray-400">running 142 tests<span class="cursor-blink text-white" aria-hidden="true">▋</span></span>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="status-dot shrink-0" data-state="idle"></span>
                        <span class="w-16 sm:w-20 shrink-0 text-gray-300">lint</span>
                        <span class="hidden sm:inline w-20 shrink-0" style="color:#60d078">idle</span>
                        <span class="flex-1 min-w-0 truncate text-gray-500">✓ 0 problems</span>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="status-dot shrink-0" data-state="idle"></span>
                        <span class="w-16 sm:w-20 shrink-0 text-gray-300">build</span>
                        <span class="hidden sm:inline w-20 shrink-0" style="color:#60d078">idle</span>
                        <span class="flex-1 min-w-0 truncate text-gray-500">✓ built in 1.2s</span>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="status-dot shrink-0" data-state="input"></span>
                        <span class="w-16 sm:w-20 shrink-0 text-gray-300">deploy</span>
                        <span class="hidden sm:inline w-20 shrink-0" style="color:#b070ff">waiting</span>
