---
import Layout from "../layouts/Layout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Attyx",
  description: "Terminal for agentic workflows. Attyx tracks agent lifecycle, drives panes over an IPC layer and the attyx CLI, and ships sessions, splits, tabs, and a command palette. GPU-accelerated, written in Zig, under 5MB.",
  url: "https://attyx.sh",
  operatingSystem: ["macOS", "Linux"],
  applicationCategory: "DeveloperApplication",
  screenshot: "https://attyx.sh/images/attyx.webp",
  author: {
    "@type": "Organization",
    name: "Semos Labs",
    url: "https://semos.sh",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Layout title="Attyx — Terminal for Agentic Workflows" description="Terminal for agentic workflows. Attyx tracks agent state in the tab bar and drives panes over an IPC layer and the attyx CLI. GPU-accelerated, written in Zig, under 5MB." jsonLd={jsonLd}>

  <!-- Boot sequence overlay -->
  <div id="boot-overlay" class="fixed inset-0 z-[200] bg-black flex items-center justify-center pointer-events-none">
    <svg id="boot-logo" width="80" height="80" viewBox="0 0 100 100" fill="none" class="opacity-0">
      <circle cx="50" cy="50" r="38" stroke="#404040" stroke-width="3" stroke-dasharray="239" stroke-dashoffset="239" class="boot-circle" />
      <line x1="22" y1="22" x2="78" y2="78" stroke="#f0f0f0" stroke-width="3" stroke-linecap="round" stroke-dasharray="80" stroke-dashoffset="80" class="boot-x1" />
      <line x1="78" y1="22" x2="22" y2="78" stroke="#f0f0f0" stroke-width="3" stroke-linecap="round" stroke-dasharray="80" stroke-dashoffset="80" class="boot-x2" />
    </svg>
  </div>

  <!-- Hero -->
  <section class="min-h-dvh flex flex-col justify-center pt-24 md:pt-32 pb-12 md:pb-20 px-6 md:px-8 relative overflow-hidden">
    <!-- Ambient grid -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#f0f0f0 1px, transparent 1px), linear-gradient(90deg, #f0f0f0 1px, transparent 1px); background-size: 60px 60px;"></div>
    <!-- Corner coordinates -->
    <div class="absolute top-20 left-6 md:left-8 text-[0.65rem] text-gray-600 font-mono tracking-wider hero-stagger" style="--delay: 0.8s">0,0</div>
    <div class="absolute top-20 right-6 md:right-8 text-[0.65rem] text-gray-600 font-mono tracking-wider hero-stagger" style="--delay: 0.85s">1920,0</div>

    <div class="max-w-content mx-auto w-full relative">
      <!-- Main heading -->
      <h1 class="hero-stagger" style="--delay: 0.5s">
        <span class="block text-[2rem] md:text-[3.6rem] lg:text-[4.2rem] leading-[1.1] tracking-[-0.03em] font-bold text-balance">
          <span class="text-gray-400">Terminal for</span><br />
          agentic workflows.
        </span>
      </h1>

      <!-- Description -->
      <p class="hero-stagger mt-6 md:mt-8 text-body-lg md:text-[1.05rem] text-gray-300 leading-copy max-w-[580px]" style="--delay: 0.6s">
        Attyx shows a colored dot on every pane — working, waiting on you, idle — and exposes an IPC layer and the <code class="text-gray-100">attyx</code> CLI so agents and scripts drive panes directly. GPU-accelerated, written in Zig, under 5&thinsp;MB.
      </p>

      <!-- Badges -->
      <div class="hero-stagger mt-5 flex items-center gap-3 flex-wrap" style="--delay: 0.65s">
        <a
          class="stars-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-3 h-3 fill-amber-400" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
          <span class="stars-count font-mono font-medium">—</span>
        </a>
        <a
          class="downloads-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx/releases"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-3 h-3 fill-gray-400" viewBox="0 0 16 16"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14ZM7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>
          <span class="dl-count font-mono font-medium">—</span>
        </a>
      </div>

      <!-- Install + CTAs row -->
      <div class="hero-stagger mt-8 md:mt-12 flex flex-col lg:flex-row gap-6 lg:gap-10 lg:items-end" style="--delay: 0.7s">
        <!-- Install block -->
        <div class="install-block bg-gray-900/80 border border-gray-700/60 rounded-xl overflow-hidden max-w-[420px] w-full backdrop-blur-sm">
          <div class="flex items-center px-4 py-2.5 bg-gray-800/60 border-b border-gray-700/40 gap-3">
            <div class="flex gap-1.5">
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
            </div>
            <span class="text-[0.65rem] text-gray-500 tracking-wider uppercase">Install</span>
            <button
              class="copy-btn group ml-auto flex items-center bg-transparent border border-gray-700/60 rounded px-2 py-0.5 cursor-pointer text-gray-500 text-[0.7rem] transition-all hover:text-white hover:border-gray-500"
              data-ph-cta="hero_copy_install"
              aria-label="Copy to clipboard"
            >
              <span class="group-[.copied]:hidden">copy</span>
              <span class="hidden group-[.copied]:inline text-gray-200">copied</span>
            </button>
          </div>
          <div class="install-panel px-5 py-4 text-[0.82rem] leading-relaxed" data-copy="brew tap semos-labs/tap&#10;brew install attyx">
            <p><span class="text-gray-500">$</span> <span class="text-white">brew tap semos-labs/tap</span></p>
            <p><span class="text-gray-500">$</span> <span class="text-white">brew install attyx</span></p>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col gap-3">
          <div class="flex gap-3 flex-wrap">
            <a href="/docs/" class="btn-primary" data-ph-cta="hero_docs">Documentation</a>
            <a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="btn-secondary" data-ph-cta="hero_github">GitHub</a>
          </div>
          <span class="text-[0.7rem] text-gray-500">macOS (Apple Silicon & Intel) &middot; Linux (x64 & ARM64)</span>
        </div>
      </div>

      <!-- Download (platform-detected, hidden by default) -->
      <div id="hero-download-wrap" class="hidden hero-stagger mt-5 flex items-center gap-4 flex-wrap" style="--delay: 0.75s">
        <a id="hero-download-btn" href="#" class="inline-flex items-center gap-2 py-2.5 px-6 bg-white text-black font-mono text-body-sm font-medium rounded-md hover:bg-gray-200 transition-colors" data-ph-cta="hero_download">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </a>
        <span id="hero-download-caption" class="text-[0.7rem] text-gray-500"></span>
      </div>
    </div>
  </section>

  <!-- Specs strip -->
  <section class="py-10 px-6 md:px-8 border-y border-gray-800/60">
    <div class="max-w-content mx-auto flex flex-wrap justify-center gap-x-4 md:gap-x-5 gap-y-2.5 text-[0.75rem] text-gray-500 font-mono tracking-wider uppercase">
      <span>Zig</span>
      <span class="text-gray-700">/</span>
      <span>Metal &middot; OpenGL</span>
      <span class="text-gray-700">/</span>
      <span>&lt; 5 MB</span>
      <span class="text-gray-700">/</span>
      <span>IPC &middot; CLI &middot; MCP</span>
      <span class="text-gray-700">/</span>
      <span>macOS &middot; Linux</span>
      <span class="text-gray-700">/</span>
      <span>MIT License</span>
    </div>
  </section>

  <!-- Agent status -->
  <section class="py-20 md:py-32 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Copy -->
        <div class="lg:col-span-5">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Agent status</span>
            <div class="flex-1 h-px bg-gray-800"></div>
          </div>
          <h2 class="heading-section mb-5">See every agent at a glance.</h2>
          <p class="text-body-lg md:text-[1.02rem] text-gray-300 leading-copy">
            Attyx reads each agent's lifecycle — from Claude, Codex, and opencode — and paints a colored dot on its pane: <span class="text-white">working</span>, <span class="text-white">waiting on you</span>, or <span class="text-white">idle</span>. Run a swarm and tell at a glance which one needs you.
          </p>
          <a href="/docs/agent-workflows/" class="group inline-flex items-center gap-2 mt-7 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_agent_status">
            <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">Agent workflows</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
        <!-- Status board -->
        <div class="lg:col-span-7">
          <div role="img" aria-label="The Attyx window as a full-screen TUI. A left rail lists four agent panes — lint idle, test working, build idle, deploy waiting on input — with the working test pane focused and running 142 tests. A top bar shows the working directory and git branch." class="agent-board bg-gray-900 border border-gray-700/50 rounded-xl overflow-hidden shadow-[0_24px_60px_-24px_rgba(0,0,0,0.8)] text-[0.75rem] font-mono">
            <!-- Top status bar -->
            <div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-gray-800 text-gray-500">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-gray-300 truncate">~/agents</span>
                <span class="flex items-center gap-1.5 shrink-0">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.508 2.508 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Z"/></svg>
                  main
                </span>
              </div>
              <span class="tabular-nums shrink-0 text-gray-500">9:16</span>
            </div>
            <!-- Body: pane rail + focused pane output -->
            <div class="flex min-h-[208px]">
              <!-- Left pane rail -->
              <div class="w-[112px] sm:w-[146px] shrink-0 border-r border-gray-800 py-2">
                <div data-state="idle" class="pane-row flex items-center gap-2 mx-2 px-2.5 py-1.5 rounded-md">
                  <span class="status-dot"></span>
                  <span class="flex-1 truncate text-gray-400">lint</span>
                  <span class="text-gray-600 text-[0.65rem] tabular-nums">1</span>
                </div>
                <div data-state="working" class="pane-row flex items-center gap-2 mx-2 px-2.5 py-1.5 rounded-md bg-gray-700/40">
                  <span class="status-dot"></span>
                  <span class="flex-1 truncate text-gray-100">test</span>
                  <span class="text-gray-400 text-[0.65rem] tabular-nums">2</span>
                </div>
                <div data-state="idle" class="pane-row flex items-center gap-2 mx-2 px-2.5 py-1.5 rounded-md">
                  <span class="status-dot"></span>
                  <span class="flex-1 truncate text-gray-400">build</span>
                  <span class="text-gray-600 text-[0.65rem] tabular-nums">3</span>
                </div>
                <div data-state="input" class="pane-row flex items-center gap-2 mx-2 px-2.5 py-1.5 rounded-md">
                  <span class="status-dot"></span>
                  <span class="flex-1 truncate text-gray-400">deploy</span>
                  <span class="text-gray-600 text-[0.65rem] tabular-nums">4</span>
                </div>
              </div>
              <!-- Focused pane output -->
              <div class="flex-1 min-w-0 px-4 py-3 leading-relaxed text-gray-400 text-[0.78rem]">
                <p><span class="text-gray-600">$</span> <span class="text-gray-200">claude -p "fix the failing tests"</span></p>
                <p class="mt-2"><span class="text-gray-300">PASS</span> <span class="text-gray-600">src/ipc/socket.test.ts</span></p>
                <p><span class="text-gray-300">PASS</span> <span class="text-gray-600">src/term/parser.test.ts</span></p>
                <p><span class="text-gray-400">RUNS</span> <span class="text-gray-600">src/render/atlas.test.ts</span></p>
                <p class="mt-2 text-gray-300">running 142 tests<span class="cursor-blink text-white" aria-hidden="true"> ▋</span></p>
              </div>
            </div>
            <!-- Bottom status line -->
            <div class="flex items-center justify-between gap-3 px-4 py-1.5 border-t border-gray-800 text-gray-600 text-[0.66rem]">
              <span><span class="text-gray-500">attyx</span> · 4 panes</span>
              <span class="hidden sm:inline tracking-wide">⌘⇧P palette</span>
            </div>
          </div>
          <!-- Legend -->
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-4 text-[0.68rem] font-mono text-gray-400 tracking-wide">
            <span class="flex items-center gap-1.5"><span class="status-dot" data-state="working"></span>working</span>
            <span class="flex items-center gap-1.5"><span class="status-dot" data-state="input"></span>waiting on you</span>
            <span class="flex items-center gap-1.5"><span class="status-dot" data-state="idle"></span>idle</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLI control -->
  <section class="py-20 md:py-32 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Copy -->
        <div class="lg:col-span-5 lg:order-2">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">CLI control</span>
            <div class="flex-1 h-px bg-gray-800"></div>
          </div>
          <h2 class="heading-section mb-5">Drive it from anywhere.</h2>
          <p class="text-body-lg md:text-[1.02rem] text-gray-300 leading-copy">
            Every pane has a stable ID. Over a Unix socket, one agent spawns panes, sends keystrokes, and reads output from any other — no focus change, no guesswork. It speaks <span class="text-gray-100">MCP</span>, too: <code class="text-gray-100">attyx mcp</code> hands the same tools to Claude Desktop and any MCP client, and the <a href="/docs/claude-code/" class="text-gray-100 hover:text-white transition-colors underline underline-offset-2 decoration-gray-700 hover:decoration-gray-400">Claude Code skill</a> drops in with <code class="text-gray-100">attyx skill install</code>.
          </p>
          <a href="/docs/integration/" class="group inline-flex items-center gap-2 mt-7 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_cli">
            <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">IPC &amp; CLI</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
        <!-- Orchestration transcript -->
        <div class="lg:col-span-7 lg:order-1">
          <div class="bg-gray-900/80 border border-gray-700/60 rounded-xl overflow-hidden backdrop-blur-sm">
            <div class="flex items-center px-4 py-2.5 bg-gray-800/60 border-b border-gray-700/40 gap-3">
              <div class="flex gap-1.5">
                <span class="w-2 h-2 rounded-full bg-gray-600"></span>
                <span class="w-2 h-2 rounded-full bg-gray-600"></span>
                <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              </div>
              <span class="text-[0.65rem] text-gray-500 tracking-wider uppercase">Orchestrate</span>
            </div>
            <pre class="px-5 py-4 text-[0.76rem] md:text-[0.8rem] leading-[1.85] font-mono overflow-x-auto"><code><span class="text-gray-400"># spawn an agent in a new pane, capture its id</span>
<span class="text-gray-600">$</span> <span class="text-gray-100">id=$(attyx split v --cmd </span><span class="text-gray-300">"claude -p 'run tests'"</span><span class="text-gray-100">)</span>
<span class="text-gray-400"># read what it's doing — anytime, no focus change</span>
<span class="text-gray-600">$</span> <span class="text-gray-100">attyx get-text -p </span><span class="text-gray-300">$id</span>
<span class="text-gray-400"># nudge it when it pauses for input</span>
<span class="text-gray-600">$</span> <span class="text-gray-100">attyx send-keys -p </span><span class="text-gray-300">$id</span><span class="text-gray-100"> </span><span class="text-gray-300">"yes&#123;Enter&#125;"</span>
<span class="text-gray-400"># clean up when it's done</span>
<span class="text-gray-600">$</span> <span class="text-gray-100">attyx split close -p </span><span class="text-gray-300">$id</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Splits & sessions -->
  <section class="py-20 md:py-32 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Copy -->
        <div class="lg:col-span-5">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Splits &amp; sessions</span>
            <div class="flex-1 h-px bg-gray-800"></div>
          </div>
          <h2 class="heading-section mb-5">Lay it out. Leave it running.</h2>
          <p class="text-body-lg md:text-[1.02rem] text-gray-300 leading-copy">
            Vertical and horizontal splits, tabs, and floating popups — all built in, no plugin needed. Sessions are backed by a daemon: close the window, reopen it tomorrow, and every pane is exactly where you left it.
          </p>
          <a href="/docs/tabs-and-splits/" class="group inline-flex items-center gap-2 mt-7 text-body-sm font-mono text-gray-400 hover:text-white transition-colors" data-ph-cta="docs_splits">
            <span class="border-b border-gray-700 pb-0.5 group-hover:border-gray-400 transition-colors">Tabs &amp; splits</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
        <!-- Split window -->
        <div class="lg:col-span-7">
          <div role="img" aria-label="An Attyx window split into three panes: an editor on the left, a running dev server top-right, and git status bottom-right." class="agent-board bg-gray-900 border border-gray-700/50 rounded-xl overflow-hidden shadow-[0_24px_60px_-24px_rgba(0,0,0,0.8)] text-[0.75rem] font-mono">
            <div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-gray-800 text-gray-500">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-gray-300 truncate">~/attyx-web</span>
                <span class="flex items-center gap-1.5 shrink-0">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.508 2.508 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Z"/></svg>
                  main
                </span>
              </div>
              <span class="tabular-nums shrink-0 text-gray-500">3 panes</span>
            </div>
            <div class="flex min-h-[200px] text-[0.72rem] leading-relaxed">
              <div class="flex-1 min-w-0 border-r border-gray-800 px-3.5 py-2.5">
                <p class="text-gray-600 mb-1.5">nvim · main.zig</p>
                <p class="text-gray-400"><span class="text-gray-600 mr-2">12</span>pub fn main() void &#123;</p>
                <p class="text-gray-400"><span class="text-gray-600 mr-2">13</span>  try term.init();</p>
                <p class="text-gray-400"><span class="text-gray-600 mr-2">14</span>  loop.run();</p>
                <p class="text-gray-400"><span class="text-gray-600 mr-2">15</span>&#125;</p>
              </div>
              <div class="w-[44%] shrink-0 flex flex-col">
                <div class="flex-1 border-b border-gray-800 px-3.5 py-2.5">
                  <p class="text-gray-600 mb-1.5">npm run dev</p>
                  <p class="text-gray-400">VITE ready in <span class="text-gray-200">421 ms</span></p>
