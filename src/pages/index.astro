---
import Layout from "../layouts/Layout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Attyx",
  description: "GPU-accelerated, scriptable terminal environment. Built-in sessions, splits, IPC, and a CLI for agentic workflows. Written in Zig, under 5MB.",
  url: "https://attyx.sh",
  operatingSystem: ["macOS", "Linux"],
  applicationCategory: "DeveloperApplication",
  screenshot: "https://attyx.sh/images/attyx.webp",
  author: {
    "@type": "Organization",
    name: "Semos Labs",
    url: "https://semos.sh",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Layout title="Attyx — GPU-Accelerated Terminal" description="GPU-accelerated, scriptable terminal environment. Built-in sessions, splits, IPC, and the attyx CLI for agentic workflows. Written in Zig, under 5MB." jsonLd={jsonLd}>

  <!-- Boot sequence overlay -->
  <div id="boot-overlay" class="fixed inset-0 z-[200] bg-black flex items-center justify-center pointer-events-none">
    <svg id="boot-logo" width="80" height="80" viewBox="0 0 100 100" fill="none" class="opacity-0">
      <circle cx="50" cy="50" r="38" stroke="#404040" stroke-width="3" stroke-dasharray="239" stroke-dashoffset="239" class="boot-circle" />
      <line x1="22" y1="22" x2="78" y2="78" stroke="#f0f0f0" stroke-width="3" stroke-linecap="round" stroke-dasharray="80" stroke-dashoffset="80" class="boot-x1" />
      <line x1="78" y1="22" x2="22" y2="78" stroke="#f0f0f0" stroke-width="3" stroke-linecap="round" stroke-dasharray="80" stroke-dashoffset="80" class="boot-x2" />
    </svg>
  </div>

  <!-- Hero -->
  <section class="min-h-dvh flex flex-col justify-center pt-24 md:pt-32 pb-12 md:pb-20 px-6 md:px-8 relative overflow-hidden">
    <!-- Ambient grid -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#f0f0f0 1px, transparent 1px), linear-gradient(90deg, #f0f0f0 1px, transparent 1px); background-size: 60px 60px;"></div>
    <!-- Corner coordinates -->
    <div class="absolute top-20 left-6 md:left-8 text-[0.65rem] text-gray-600 font-mono tracking-wider hero-stagger" style="--delay: 0.8s">0,0</div>
    <div class="absolute top-20 right-6 md:right-8 text-[0.65rem] text-gray-600 font-mono tracking-wider hero-stagger" style="--delay: 0.85s">1920,0</div>

    <div class="max-w-content mx-auto w-full relative">
      <!-- Main heading -->
      <h1 class="hero-stagger" style="--delay: 0.5s">
        <span class="block text-[2rem] md:text-[3.6rem] lg:text-[4.2rem] leading-[1.1] tracking-[-0.03em] font-bold">
          Your terminal,<br />
          <span class="text-gray-400">without the duct tape.</span>
        </span>
      </h1>

      <!-- Description -->
      <p class="hero-stagger mt-6 md:mt-8 text-body-lg md:text-[1.05rem] text-gray-400 leading-copy max-w-[560px]" style="--delay: 0.6s">
        Sessions, splits, tabs, command palette — plus a scriptable IPC layer and the <code class="text-gray-300">attyx</code> CLI, so AI agents and scripts can drive your terminal programmatically. GPU-accelerated, written in Zig, under 5&thinsp;MB.
      </p>

      <!-- Badges -->
      <div class="hero-stagger mt-5 flex items-center gap-3 flex-wrap" style="--delay: 0.65s">
        <a
          class="stars-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-3 h-3 fill-amber-400" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
          <span class="stars-count font-mono font-medium">—</span>
        </a>
        <a
          class="downloads-badge hidden data-[loaded]:inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-gray-900 border border-gray-700 rounded-full text-small text-gray-400 hover:border-gray-500 hover:text-white transition-colors"
          data-repo="semos-labs/attyx"
          href="https://github.com/semos-labs/attyx/releases"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-3 h-3 fill-gray-400" viewBox="0 0 16 16"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14ZM7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>
          <span class="dl-count font-mono font-medium">—</span>
        </a>
      </div>

      <!-- Install + CTAs row -->
      <div class="hero-stagger mt-8 md:mt-12 flex flex-col lg:flex-row gap-6 lg:gap-10 lg:items-end" style="--delay: 0.7s">
        <!-- Install block -->
        <div class="install-block bg-gray-900/80 border border-gray-700/60 rounded-xl overflow-hidden max-w-[420px] w-full backdrop-blur-sm">
          <div class="flex items-center px-4 py-2.5 bg-gray-800/60 border-b border-gray-700/40 gap-3">
            <div class="flex gap-1.5">
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
            </div>
            <span class="text-[0.65rem] text-gray-500 tracking-wider uppercase">Install</span>
            <button
              class="copy-btn group ml-auto flex items-center bg-transparent border border-gray-700/60 rounded px-2 py-0.5 cursor-pointer text-gray-500 text-[0.7rem] transition-all hover:text-white hover:border-gray-500"
              data-ph-cta="hero_copy_install"
              aria-label="Copy to clipboard"
            >
              <span class="group-[.copied]:hidden">copy</span>
              <span class="hidden group-[.copied]:inline text-gray-200">copied</span>
            </button>
          </div>
          <div class="install-panel px-5 py-4 text-[0.82rem] leading-relaxed" data-copy="brew tap semos-labs/tap&#10;brew install attyx">
            <p><span class="text-gray-500">$</span> <span class="text-white">brew tap semos-labs/tap</span></p>
            <p><span class="text-gray-500">$</span> <span class="text-white">brew install attyx</span></p>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col gap-3">
          <div class="flex gap-3 flex-wrap">
            <a href="/docs/" class="btn-primary" data-ph-cta="hero_docs">Documentation</a>
            <a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="btn-secondary" data-ph-cta="hero_github">GitHub</a>
          </div>
          <span class="text-[0.7rem] text-gray-500">macOS (Apple Silicon & Intel) &middot; Linux (x64 & ARM64)</span>
        </div>
      </div>

      <!-- Download (platform-detected, hidden by default) -->
      <div id="hero-download-wrap" class="hidden hero-stagger mt-5 flex items-center gap-4 flex-wrap" style="--delay: 0.75s">
        <a id="hero-download-btn" href="#" class="inline-flex items-center gap-2 py-2.5 px-6 bg-white text-black font-mono text-body-sm font-medium rounded-md hover:bg-gray-200 transition-colors" data-ph-cta="hero_download">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </a>
        <span id="hero-download-caption" class="text-[0.7rem] text-gray-500"></span>
      </div>
    </div>
  </section>

  <!-- Screenshot -->
  <section class="px-4 md:px-8 pb-16 md:pb-32 -mt-8 md:-mt-16 relative">
    <div class="max-w-[1000px] mx-auto">
      <!-- Floating labels -->
      <div class="hidden lg:block absolute -left-2 top-1/4 text-[0.6rem] text-gray-600 font-mono tracking-wider -rotate-90 origin-left translate-y-12">SPLITS</div>
      <div class="hidden lg:block absolute -right-2 top-1/3 text-[0.6rem] text-gray-600 font-mono tracking-wider rotate-90 origin-right translate-y-12">PALETTE</div>

      <div class="relative">
        <!-- Glow -->
        <div class="absolute -inset-12 bg-gradient-to-b from-white/[0.02] via-white/[0.04] to-transparent rounded-3xl blur-3xl pointer-events-none"></div>

        <!-- Window frame -->
        <div class="relative bg-gray-900 border border-gray-700/50 rounded-xl overflow-hidden shadow-[0_30px_80px_-20px_rgba(0,0,0,0.8)]">
          <!-- Title bar -->
          <div class="flex items-center gap-2 px-4 py-3 bg-gray-800/70 border-b border-gray-700/50">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
            <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
            <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 text-[0.65rem] text-gray-500 font-mono tracking-wider">attyx</span>
          </div>
          <img src="/images/attyx.webp" alt="Attyx — GPU-accelerated terminal with splits, command palette, and status bar" class="w-full block" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <!-- Specs strip -->
  <section class="py-10 px-6 md:px-8 border-y border-gray-800/60">
    <div class="max-w-content mx-auto flex flex-wrap justify-center gap-x-10 gap-y-4 text-[0.75rem] text-gray-500 font-mono tracking-wider uppercase">
      <span>Zig</span>
      <span class="text-gray-700">/</span>
      <span>Metal &middot; OpenGL</span>
      <span class="text-gray-700">/</span>
      <span>&lt; 5 MB</span>
      <span class="text-gray-700">/</span>
      <span>IPC + CLI</span>
      <span class="text-gray-700">/</span>
      <span>macOS &middot; Linux</span>
      <span class="text-gray-700">/</span>
      <span>MIT License</span>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 md:py-32 px-6 md:px-8">
    <div class="max-w-content mx-auto">
      <!-- Section label -->
      <div class="flex items-center gap-4 mb-12 md:mb-16">
        <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase">Features</span>
        <div class="flex-1 h-px bg-gray-800"></div>
        <span class="text-[0.65rem] text-gray-600 font-mono">12</span>
      </div>

      <!-- Feature grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-800/50 rounded-xl overflow-hidden border border-gray-800/50">
        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">01</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Scriptable IPC</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Control splits, send input, read output — all over a Unix socket. Build workflows, dashboards, or let AI agents orchestrate your terminal.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">02</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">attyx CLI</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">A companion CLI that talks to the running terminal. Create panes, send keystrokes, read screen content — perfect for agentic workflows.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">03</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">GPU Rendering</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Metal on macOS, OpenGL on Linux. Smooth scrolling, no tearing — stays fast even when you <code class="text-gray-400">cat</code> a huge file.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">04</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Sessions</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Persistent workspaces backed by a daemon. Close the window, open it later — everything's still there.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">05</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Splits & Tabs</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Horizontal and vertical splits, tabs, and floating popups. All built in, no plugin needed.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">06</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Themes & Config</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">22 built-in themes and TOML config with hot reload. Edit, save, done.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">07</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Command Palette</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Cmd+Shift+P — searchable list of every action. Forgot a shortcut? Just look it up.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">08</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Search</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Search through output and scrollback. Regex, smart-case, incremental — finds stuff as you type.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">09</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Visual Mode</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Select text with the keyboard, vim-style. Character, line, and block modes. Yank to clipboard.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">10</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Status Bar</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Git branch, working directory, clock, or your own scripts. Shows what you need, stays out of the way.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">11</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Inline Images</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Kitty graphics protocol. Show images, plots, whatever — right in the terminal.</p>
        </div>

        <div class="feature-card bg-black p-7 md:p-8 group">
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-[0.65rem] text-gray-600 font-mono tabular-nums">12</span>
            <h3 class="text-[0.95rem] font-bold group-hover:text-white transition-colors">Cross-Platform</h3>
          </div>
          <p class="text-small text-gray-500 leading-relaxed pl-7">Native on macOS and Linux. Metal + Core Text or OpenGL + FreeType. Same app, different backends.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Semos -->
  <section class="py-16 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <span class="text-[0.65rem] text-gray-600 font-mono tracking-[0.3em] uppercase">Part of</span>
        <a href="https://semos.sh" target="_blank" rel="noopener" class="text-[0.75rem] text-gray-300 font-mono tracking-wider uppercase hover:text-white transition-colors">Semos Labs</a>
      </div>
      <p class="text-small text-gray-500 text-center md:text-right max-w-[400px]">
        A constellation of terminal-native tools — Attyx, <a href="https://semos.sh/glyph" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors">Glyph</a>, <a href="https://semos.sh/aion" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors">Aion</a>, and <a href="https://semos.sh/epist" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors">Epist</a>.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-[640px] mx-auto text-center">
      <p class="text-[0.65rem] text-gray-600 font-mono tracking-[0.3em] uppercase mb-6">Get started</p>
      <h2 class="heading-section mb-4">Try Attyx</h2>
      <p class="text-body-lg text-gray-400 leading-copy mb-10">
        Install via Homebrew and you're up and running in seconds.
      </p>
      <!-- Install block -->
      <div class="install-block bg-gray-900/80 border border-gray-700/60 rounded-xl overflow-hidden max-w-[420px] w-full mx-auto backdrop-blur-sm mb-6">
        <div class="flex items-center px-4 py-2.5 bg-gray-800/60 border-b border-gray-700/40 gap-3">
          <div class="flex gap-1.5">
            <span class="w-2 h-2 rounded-full bg-gray-600"></span>
            <span class="w-2 h-2 rounded-full bg-gray-600"></span>
            <span class="w-2 h-2 rounded-full bg-gray-600"></span>
          </div>
          <span class="text-[0.65rem] text-gray-500 tracking-wider uppercase">Install</span>
          <button
            class="copy-btn group ml-auto flex items-center bg-transparent border border-gray-700/60 rounded px-2 py-0.5 cursor-pointer text-gray-500 text-[0.7rem] transition-all hover:text-white hover:border-gray-500"
            data-ph-cta="footer_copy_install"
            aria-label="Copy to clipboard"
          >
            <span class="group-[.copied]:hidden">copy</span>
            <span class="hidden group-[.copied]:inline text-gray-200">copied</span>
          </button>
        </div>
        <div class="install-panel px-5 py-4 text-[0.82rem] leading-relaxed text-left" data-copy="brew tap semos-labs/tap&#10;brew install attyx">
          <p><span class="text-gray-500">$</span> <span class="text-white">brew tap semos-labs/tap</span></p>
          <p><span class="text-gray-500">$</span> <span class="text-white">brew install attyx</span></p>
        </div>
      </div>

      <!-- Download (platform-detected, hidden by default) -->
      <div id="footer-download-wrap" class="hidden flex justify-center items-center gap-4 flex-wrap mb-8">
        <a id="footer-download-btn" href="#" class="inline-flex items-center gap-2 py-2.5 px-6 bg-white text-black font-mono text-body-sm font-medium rounded-md hover:bg-gray-200 transition-colors" data-ph-cta="footer_download">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </a>
        <span id="footer-download-caption" class="text-[0.7rem] text-gray-500"></span>
      </div>

      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/docs/" class="btn-primary" data-ph-cta="footer_docs">Read the Docs</a>
        <a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="btn-secondary" data-ph-cta="footer_github">View Source</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Boot sequence */
  @keyframes draw-circle {
    to { stroke-dashoffset: 0; }
  }
  @keyframes draw-line {
    to { stroke-dashoffset: 0; }
  }
  @keyframes boot-fade {
    0% { opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes boot-logo-in {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  #boot-logo {
    animation: boot-logo-in 0.3s ease-out 0.1s forwards;
  }
  .boot-circle {
    animation: draw-circle 0.6s ease-out 0.2s forwards;
  }
  .boot-x1 {
    animation: draw-line 0.3s ease-out 0.5s forwards;
  }
  .boot-x2 {
    animation: draw-line 0.3s ease-out 0.65s forwards;
  }
  #boot-overlay {
    animation: boot-fade 1.2s ease-out 0.9s forwards;
  }

  /* Hero stagger */
  .hero-stagger {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-enter 0.6s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
  }
  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Feature cards hover line */
  .feature-card {
    position: relative;
    transition: background-color 0.2s;
  }
  .feature-card:hover {
    background-color: #0e0e0e;
  }
  .feature-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: transparent;
    transition: background 0.3s;
  }
  .feature-card:hover::before {
    background: #2a2a2a;
  }
</style>

<script>
  // Install block copy
  document.querySelectorAll('.install-block').forEach((block) => {
    const copyBtn = block.querySelector('.copy-btn');
    copyBtn?.addEventListener('click', async () => {
      const panel = block.querySelector('.install-panel');
      const text = panel?.getAttribute('data-copy') || '';
      await navigator.clipboard.writeText(text);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 2000);
    });
  });

  // Platform detection & download button
  const platforms: Record<string, { label: string; file: string }> = {
    'darwin-arm64': { label: 'macOS (Apple Silicon)', file: 'attyx-darwin-arm64.dmg' },
    'darwin-x64':   { label: 'macOS (Intel)',         file: 'attyx-darwin-x64.dmg' },
    'linux-x64':    { label: 'Linux (x64)',           file: 'attyx-linux-x64.tar.zst' },
  };

  function isAppleSilicon(): boolean {
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
      if (!gl) return true;
      const ext = gl.getExtension('WEBGL_debug_renderer_info');
      if (!ext) return true;
      const renderer = (gl as WebGLRenderingContext).getParameter(ext.UNMASKED_RENDERER_WEBGL);
      return /apple/i.test(renderer) && !/intel/i.test(renderer);
    } catch {
      return true;
    }
  }

  function detectPlatform(): string | null {
    const ua = navigator.userAgent.toLowerCase();
    const platform = navigator.platform?.toLowerCase() || '';
    if (ua.includes('mac') || platform.includes('mac')) {
      return isAppleSilicon() ? 'darwin-arm64' : 'darwin-x64';
    }
    if (ua.includes('linux') && !ua.includes('android')) {
      return 'linux-x64';
    }
    return null;
  }

  const detected = detectPlatform();
  const wrap = document.getElementById('hero-download-wrap');
  const btn = document.getElementById('hero-download-btn') as HTMLAnchorElement | null;
  const caption = document.getElementById('hero-download-caption');

  if (detected) {
    const meta = platforms[detected];
    const baseUrl = 'https://github.com/semos-labs/attyx/releases/latest/download/';

    // Wire up both hero and footer download buttons
    const downloadSections = [
      { wrap: 'hero-download-wrap', btn: 'hero-download-btn', caption: 'hero-download-caption' },
      { wrap: 'footer-download-wrap', btn: 'footer-download-btn', caption: 'footer-download-caption' },
    ];

    for (const ids of downloadSections) {
      const w = document.getElementById(ids.wrap);
      const b = document.getElementById(ids.btn) as HTMLAnchorElement | null;
      const c = document.getElementById(ids.caption);
      if (w && b && c) {
        b.href = baseUrl + meta.file;
        c.textContent = meta.label;
        w.classList.remove('hidden');
      }
    }

    fetch('https://api.github.com/repos/semos-labs/attyx/releases/latest')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (data?.tag_name) {
          for (const ids of downloadSections) {
            const c = document.getElementById(ids.caption);
            if (c) c.textContent = `${meta.label} · ${data.tag_name}`;
          }
        }
      })
      .catch(() => {});
  }

  // Fetch GitHub stars
  document.querySelectorAll<HTMLElement>('.stars-badge').forEach(async (badge) => {
    const repo = badge.getAttribute('data-repo');
    if (!repo) return;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`);
      if (!res.ok) return;
      const data = await res.json();
      const count = badge.querySelector('.stars-count');
      if (count) count.textContent = data.stargazers_count?.toLocaleString() ?? '0';
      badge.dataset.loaded = '';
    } catch {}
  });

  // Fetch GitHub downloads
  document.querySelectorAll<HTMLElement>('.downloads-badge').forEach(async (badge) => {
    const repo = badge.getAttribute('data-repo');
    if (!repo) return;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=100`);
      if (!res.ok) return;
      const releases = await res.json();
      const total = releases.reduce((sum: number, r: any) =>
        sum + r.assets.reduce((a: number, asset: any) => a + (asset.download_count || 0), 0), 0);
      const count = badge.querySelector('.dl-count');
      if (count) count.textContent = total.toLocaleString();
      badge.dataset.loaded = '';
    } catch {}
  });

  // Skip boot animation if already seen recently
  const bootKey = 'attyx_boot_seen';
  const bootTTL = 30 * 60 * 1000; // 30 min
  try {
    const seen = localStorage.getItem(bootKey);
    if (seen && Date.now() - Number(seen) < bootTTL) {
      const overlay = document.getElementById('boot-overlay');
      if (overlay) overlay.style.display = 'none';
      document.querySelectorAll('.hero-stagger').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
        (el as HTMLElement).style.animation = 'none';
      });
    } else {
      localStorage.setItem(bootKey, String(Date.now()));
    }
  } catch {}
</script>
