  <!-- FAQ -->
  <section class="py-20 md:py-28 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto">
      <div class="flex items-center gap-4 mb-10 md:mb-14">
        <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase shrink-0">FAQ</span>
        <div class="flex-1 h-px bg-gray-800"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-16 gap-y-9 md:gap-y-12">
        <div>
          <h3 class="text-title text-white font-bold mb-3">Is this a tmux replacement?</h3>
          <p class="text-body-sm md:text-[0.95rem] text-gray-400 leading-copy">
            Sessions, splits, tabs, and floating popups are all built in — no tmux, no config pile. A background daemon keeps sessions alive, so you can close the window and reattach with every pane intact.
          </p>
        </div>
        <div>
          <h3 class="text-title text-white font-bold mb-3">Why Zig?</h3>
          <p class="text-body-sm md:text-[0.95rem] text-gray-400 leading-copy">
            A single native binary under 5&thinsp;MB — no Electron, no Chromium, no bundled browser. It's GPU-rendered on Metal and OpenGL, starts instantly, and sips memory.
          </p>
        </div>
        <div>
          <h3 class="text-title text-white font-bold mb-3">Will it run my shell and TUIs?</h3>
          <p class="text-body-sm md:text-[0.95rem] text-gray-400 leading-copy">
            Yes — it's a real terminal. Your shell, Neovim, htop, even inline images via the Kitty protocol all work, alongside regex scrollback search and a vim-style visual mode.
          </p>
        </div>
        <div>
          <h3 class="text-title text-white font-bold mb-3">How does it track agents?</h3>
          <p class="text-body-sm md:text-[0.95rem] text-gray-400 leading-copy">
            It reads Claude and Codex lifecycle through JSON hooks, and opencode and pi.dev through event-bus extensions, then paints a status dot on each pane and tab — working, waiting on you, or idle.
          </p>
        </div>
        <div>
          <h3 class="text-title text-white font-bold mb-3">Can agents drive it?</h3>
          <p class="text-body-sm md:text-[0.95rem] text-gray-400 leading-copy">
            That's the point. An IPC layer, the <code class="text-gray-200">attyx</code> CLI, and a native <a href="/docs/mcp/" class="text-gray-200 hover:text-white transition-colors underline underline-offset-2 decoration-gray-700 hover:decoration-gray-400">MCP server</a> expose panes, keystrokes, and output as typed tools — so one agent can spawn, watch, and coordinate others.
          </p>
        </div>
        <div>
          <h3 class="text-title text-white font-bold mb-3">Which platforms?</h3>
          <p class="text-body-sm md:text-[0.95rem] text-gray-400 leading-copy">
            macOS (Apple Silicon &amp; Intel) and Linux (x64 &amp; ARM64), both native. Grab a build from the <a href="https://github.com/semos-labs/attyx/releases" target="_blank" rel="noopener" class="text-gray-200 hover:text-white transition-colors underline underline-offset-2 decoration-gray-700 hover:decoration-gray-400">releases page</a> or via Homebrew. MIT licensed, all of it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Semos -->
  <section class="py-16 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <span class="text-[0.65rem] text-gray-600 font-mono tracking-[0.3em] uppercase">Part of</span>
        <a href="https://semos.sh" target="_blank" rel="noopener" class="text-[0.75rem] text-gray-300 font-mono tracking-wider uppercase hover:text-white transition-colors">Semos Labs</a>
      </div>
      <p class="text-small text-gray-500 text-center md:text-right max-w-[400px]">
        A constellation of terminal-native tools — Attyx, <a href="https://semos.sh/glyph" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors">Glyph</a>, <a href="https://semos.sh/aion" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors">Aion</a>, and <a href="https://semos.sh/epist" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors">Epist</a>.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28 px-6 md:px-8 border-t border-gray-800/60">
    <div class="max-w-content mx-auto">
      <!-- Header -->
      <div class="mb-10 md:mb-12 max-w-[640px]">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-[0.65rem] text-gray-500 font-mono tracking-[0.3em] uppercase shrink-0">Get started</span>
          <div class="flex-1 h-px bg-gray-800"></div>
        </div>
        <h2 class="heading-section mb-4">Try Attyx.</h2>
        <p class="text-body-lg md:text-[1.02rem] text-gray-300 leading-copy">
          Install via Homebrew or grab a native build — you're up and running in seconds.
        </p>
      </div>

      <!-- Install (half) + a vertical action list to the right -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 lg:gap-6 items-stretch">
        <!-- Install -->
        <div class="install-block flex flex-col bg-gray-900/80 border border-gray-700/60 rounded-xl overflow-hidden backdrop-blur-sm">
          <div class="flex items-center px-4 py-2.5 bg-gray-800/60 border-b border-gray-700/40 gap-3">
            <div class="flex gap-1.5">
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
              <span class="w-2 h-2 rounded-full bg-gray-600"></span>
            </div>
            <span class="text-[0.65rem] text-gray-500 tracking-wider uppercase">Install</span>
            <button
              class="copy-btn group ml-auto flex items-center bg-transparent border border-gray-700/60 rounded px-2 py-0.5 cursor-pointer text-gray-500 text-[0.7rem] transition-all hover:text-white hover:border-gray-500"
              data-ph-cta="footer_copy_install"
              aria-label="Copy to clipboard"
            >
              <span class="group-[.copied]:hidden">copy</span>
              <span class="hidden group-[.copied]:inline text-gray-200">copied</span>
            </button>
          </div>
          <div class="install-panel flex-1 px-5 py-4 text-[0.82rem] leading-loose" data-copy="brew tap semos-labs/tap&#10;brew install attyx">
            <p><span class="text-gray-500">$</span> <span class="text-white">brew tap semos-labs/tap</span></p>
            <p><span class="text-gray-500">$</span> <span class="text-white">brew install attyx</span></p>
            <p><span class="text-gray-500">$</span> <span class="text-white">attyx</span> <span class="text-gray-600"># launch it</span></p>
          </div>
        </div>

        <!-- Actions — vertical list -->
        <div class="flex flex-col gap-3">
          <!-- Download (platform-detected, hidden by default) -->
          <div id="footer-download-wrap" class="hidden flex flex-col gap-1.5">
            <a id="footer-download-btn" href="#" class="flex items-center justify-center gap-2 py-3 px-5 bg-white text-black font-mono text-body-sm font-medium rounded-md hover:bg-gray-200 transition-colors" data-ph-cta="footer_download">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download
            </a>
            <span id="footer-download-caption" class="text-[0.68rem] text-gray-500 text-center"></span>
          </div>
          <a href="/docs/" class="group flex items-center justify-center gap-2 py-3 px-5 border border-gray-500 rounded-md font-mono text-body-sm text-white tracking-wide transition-all hover:bg-white hover:text-black hover:border-white" data-ph-cta="footer_docs">
            Read the docs
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="https://github.com/semos-labs/attyx" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 py-3 px-5 border border-gray-700 rounded-md font-mono text-body-sm text-gray-300 tracking-wide transition-all hover:text-white hover:border-gray-500" data-ph-cta="footer_github">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.76-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            View source
          </a>
          <span class="mt-auto pt-1 text-[0.7rem] text-gray-500 text-center">macOS (Apple Silicon &amp; Intel) &middot; Linux (x64 &amp; ARM64)</span>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Boot sequence */
  @keyframes draw-circle {
    to { stroke-dashoffset: 0; }
  }
  @keyframes draw-line {
    to { stroke-dashoffset: 0; }
  }
  @keyframes boot-fade {
    0% { opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes boot-logo-in {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  #boot-logo {
    animation: boot-logo-in 0.3s ease-out 0.1s forwards;
  }
  .boot-circle {
    animation: draw-circle 0.6s ease-out 0.2s forwards;
  }
  .boot-x1 {
    animation: draw-line 0.3s ease-out 0.5s forwards;
  }
  .boot-x2 {
    animation: draw-line 0.3s ease-out 0.65s forwards;
  }
  #boot-overlay {
    animation: boot-fade 1.2s ease-out 0.9s forwards;
  }

  /* Hero stagger */
  .hero-stagger {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-enter 0.6s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
  }
  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Agent console — status dots quote Attyx's real per-pane indicators.
     idle=green #60d078, working=orange #ffaa40, needs-input=purple #b070ff
     (matches src/app/tab_bar.zig agent_*_fg). See DESIGN.md Quotation Rule. */
  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #404040;
    flex-shrink: 0;
    position: relative;
  }
  .pane-row[data-state="idle"] .status-dot,
  .status-dot[data-state="idle"] {
    background: #60d078;
  }
  .pane-row[data-state="working"] .status-dot,
  .status-dot[data-state="working"] {
    background: #ffaa40;
  }
  .pane-row[data-state="input"] .status-dot,
  .status-dot[data-state="input"] {
    background: #b070ff;
  }


  /* ---- Feature showcase ---- */
  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  /* Left tab sidebar */
  .term-tab { color: var(--color-gray-400); }
  .term-tab:hover { color: var(--color-gray-200); background: rgba(255, 255, 255, 0.03); }
  .term-tab.is-active {
    background: var(--color-gray-800);
    color: var(--color-white);
  }
  .term-tab.is-active .term-tab-num { color: var(--color-gray-400); }
  /* Sparkle marks the focused tab — hidden on the rest */
  .term-tab-spark { display: none; }
  .term-tab.is-active .term-tab-spark { display: inline; }

  /* Screens cross-fade: blur + lift + scale as the active feature changes */
  .screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(14px) scale(0.99);
    filter: blur(7px);
    transition:
      opacity 0.5s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
    pointer-events: none;
  }
  .screen.is-active {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  /* Copy panel cross-fade — softer blur than the terminal so text stays crisp */
  .copy-screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(10px);
    filter: blur(4px);
    transition:
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.45s ease;
    pointer-events: none;
  }
  /* Active header screen goes in-flow so the container sizes to it (dynamic
     height); inactive screens stay absolutely stacked for the cross-fade. */
  .copy-screen.is-active {
    position: relative;
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  /* Reduced motion: freeze all autoplay, keep content visible */
  @media (prefers-reduced-motion: reduce) {
    #boot-overlay { display: none !important; }
    .hero-stagger {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .cursor-blink,
    .status-dot {
      animation: none !important;
    }
    .cursor-blink { opacity: 1; }
    #boot-logo,
    .boot-circle,
    .boot-x1,
    .boot-x2 {
      animation: none !important;
    }
    .screen,
    .copy-screen {
      filter: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Install block copy
  document.querySelectorAll('.install-block').forEach((block) => {
    const copyBtn = block.querySelector('.copy-btn');
    copyBtn?.addEventListener('click', async () => {
      const panel = block.querySelector('.install-panel');
      const text = panel?.getAttribute('data-copy') || '';
      await navigator.clipboard.writeText(text);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 2000);
    });
  });

  // Feature showcase: copy + terminal cross-fade together, driven by which
  // sentinel is crossing the viewport centre (where the centered stage sits).
  const showcase = document.getElementById('showcase');
  if (showcase) {
    const steps = Array.from(showcase.querySelectorAll<HTMLElement>('.step'));
    const screens = Array.from(showcase.querySelectorAll<HTMLElement>('.screen'));
    const copies = Array.from(showcase.querySelectorAll<HTMLElement>('.copy-screen'));
    const tabs = Array.from(showcase.querySelectorAll<HTMLElement>('.term-tab'));
    const pathEl = showcase.querySelector<HTMLElement>('.term-path');
    let current = -1;

    function activate(i: number) {
      if (i === current || i < 0 || i >= screens.length) return;
      current = i;
      screens.forEach((s, n) => s.classList.toggle('is-active', n === i));
      copies.forEach((s, n) => s.classList.toggle('is-active', n === i));
      tabs.forEach((t, n) => {
        t.classList.toggle('is-active', n === i);
        t.setAttribute('aria-selected', n === i ? 'true' : 'false');
      });
      if (pathEl) pathEl.textContent = screens[i].dataset.path || '';
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) activate(steps.indexOf(e.target as HTMLElement));
      }
    }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
    steps.forEach((s) => io.observe(s));

    // Tabs jump to their feature
    tabs.forEach((t, i) =>
      t.addEventListener('click', () =>
        steps[i]?.scrollIntoView({ block: 'center', behavior: 'smooth' })
      )
    );

    activate(0);
  }

  // Platform detection & download button
  const platforms: Record<string, { label: string; file: string }> = {
    'darwin-arm64': { label: 'macOS (Apple Silicon)', file: 'attyx-darwin-arm64.dmg' },
    'darwin-x64':   { label: 'macOS (Intel)',         file: 'attyx-darwin-x64.dmg' },
    'linux-x64':    { label: 'Linux (x64)',           file: 'attyx-linux-x64.tar.zst' },
  };

  function isAppleSilicon(): boolean {
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
      if (!gl) return true;
      const ext = gl.getExtension('WEBGL_debug_renderer_info');
      if (!ext) return true;
      const renderer = (gl as WebGLRenderingContext).getParameter(ext.UNMASKED_RENDERER_WEBGL);
      return /apple/i.test(renderer) && !/intel/i.test(renderer);
    } catch {
      return true;
    }
  }

  function detectPlatform(): string | null {
    const ua = navigator.userAgent.toLowerCase();
    const platform = navigator.platform?.toLowerCase() || '';
    if (ua.includes('mac') || platform.includes('mac')) {
      return isAppleSilicon() ? 'darwin-arm64' : 'darwin-x64';
    }
    if (ua.includes('linux') && !ua.includes('android')) {
      return 'linux-x64';
    }
    return null;
  }

  const detected = await detectPlatform();
  const wrap = document.getElementById('hero-download-wrap');
  const btn = document.getElementById('hero-download-btn') as HTMLAnchorElement | null;
  const caption = document.getElementById('hero-download-caption');

  if (detected) {
    const meta = platforms[detected];
    const baseUrl = 'https://github.com/semos-labs/attyx/releases/latest/download/';

    // Wire up both hero and footer download buttons
    const downloadSections = [
      { wrap: 'hero-download-wrap', btn: 'hero-download-btn', caption: 'hero-download-caption' },
      { wrap: 'footer-download-wrap', btn: 'footer-download-btn', caption: 'footer-download-caption' },
    ];

    for (const ids of downloadSections) {
      const w = document.getElementById(ids.wrap);
      const b = document.getElementById(ids.btn) as HTMLAnchorElement | null;
      const c = document.getElementById(ids.caption);
      if (w && b && c) {
        b.href = baseUrl + meta.file;
        c.textContent = meta.label;
        w.classList.remove('hidden');
      }
    }

    fetch('https://api.github.com/repos/semos-labs/attyx/releases/latest')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (data?.tag_name) {
          for (const ids of downloadSections) {
            const c = document.getElementById(ids.caption);
            if (c) c.textContent = `${meta.label} · ${data.tag_name}`;
          }
        }
      })
      .catch(() => {});
  }

  // Fetch latest release version
  document.querySelectorAll<HTMLElement>('.version-badge').forEach(async (badge) => {
    const repo = badge.getAttribute('data-repo');
    if (!repo) return;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases/latest`);
      if (!res.ok) return;
      const data = await res.json();
      const tag = badge.querySelector('.version-tag');
      if (tag && data.tag_name) tag.textContent = data.tag_name;
      badge.dataset.loaded = '';
    } catch {}
  });

  // Fetch GitHub stars
  document.querySelectorAll<HTMLElement>('.stars-badge').forEach(async (badge) => {
    const repo = badge.getAttribute('data-repo');
    if (!repo) return;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`);
      if (!res.ok) return;
      const data = await res.json();
      const count = badge.querySelector('.stars-count');
      if (count) count.textContent = data.stargazers_count?.toLocaleString() ?? '0';
      badge.dataset.loaded = '';
    } catch {}
  });

  // Fetch GitHub downloads
  document.querySelectorAll<HTMLElement>('.downloads-badge').forEach(async (badge) => {
    const repo = badge.getAttribute('data-repo');
    if (!repo) return;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=100`);
      if (!res.ok) return;
      const releases = await res.json();
      const total = releases.reduce((sum: number, r: any) =>
        sum + r.assets.reduce((a: number, asset: any) => a + (asset.download_count || 0), 0), 0);
      const count = badge.querySelector('.dl-count');
      if (count) count.textContent = total.toLocaleString();
      badge.dataset.loaded = '';
    } catch {}
  });

  // Skip boot animation if already seen recently
  const bootKey = 'attyx_boot_seen';
  const bootTTL = 30 * 60 * 1000; // 30 min
  try {
    const seen = localStorage.getItem(bootKey);
    if (seen && Date.now() - Number(seen) < bootTTL) {
      const overlay = document.getElementById('boot-overlay');
      if (overlay) overlay.style.display = 'none';
      document.querySelectorAll('.hero-stagger').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
        (el as HTMLElement).style.animation = 'none';
      });
    } else {
      localStorage.setItem(bootKey, String(Date.now()));
    }
  } catch {}
</script>
