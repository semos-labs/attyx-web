    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes boot-logo-in {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  #boot-logo {
    animation: boot-logo-in 0.3s ease-out 0.1s forwards;
  }
  .boot-circle {
    animation: draw-circle 0.6s ease-out 0.2s forwards;
  }
  .boot-x1 {
    animation: draw-line 0.3s ease-out 0.5s forwards;
  }
  .boot-x2 {
    animation: draw-line 0.3s ease-out 0.65s forwards;
  }
  #boot-overlay {
    animation: boot-fade 1.2s ease-out 0.9s forwards;
  }

  /* Hero stagger */
  .hero-stagger {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-enter 0.6s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
  }
  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Agent console — status dots quote Attyx's real per-pane indicators.
     idle=green #60d078, working=orange #ffaa40, needs-input=purple #b070ff
     (matches src/app/tab_bar.zig agent_*_fg). See DESIGN.md Quotation Rule. */
  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #404040;
    flex-shrink: 0;
    position: relative;
  }
  .pane-row[data-state="idle"] .status-dot,
  .status-dot[data-state="idle"] {
    background: #60d078;
  }
  .pane-row[data-state="working"] .status-dot,
  .status-dot[data-state="working"] {
    background: #ffaa40;
  }
  .pane-row[data-state="input"] .status-dot,
  .status-dot[data-state="input"] {
    background: #b070ff;
  }

  /* Pulse ring on working + needs-input dots */
  .pane-row[data-state="working"] .status-dot::after,
  .status-dot[data-state="working"]::after,
  .pane-row[data-state="input"] .status-dot::after,
  .status-dot[data-state="input"]::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    border: 1px solid currentColor;
    color: #ffaa40;
    opacity: 0;
    animation: dot-pulse 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .pane-row[data-state="input"] .status-dot::after,
  .status-dot[data-state="input"]::after {
    color: #b070ff;
  }
  @keyframes dot-pulse {
    0% { transform: scale(0.7); opacity: 0.6; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  /* Reduced motion: freeze all autoplay, keep content visible */
  @media (prefers-reduced-motion: reduce) {
    #boot-overlay { display: none !important; }
    .hero-stagger {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
